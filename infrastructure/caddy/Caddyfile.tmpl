# Rendered by Caddy from SITE_DOMAIN, API_DOMAIN, and SUBSCRIPTION_DOMAIN.
# Keep these as independent settings so the subscription host can migrate
# without changing application code.

{
  email admin@{$SITE_DOMAIN}
}

{$SITE_DOMAIN}, {$API_DOMAIN}, {$SUBSCRIPTION_DOMAIN} {
  log
  log_skip /s/*
  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Keep one site block so staging is valid even when the three configured
  # domains intentionally share one temporary hostname. The API host matcher
  # still preserves the separate API-domain behavior when it is distinct.
  @api host {$API_DOMAIN}
  handle @api {
    reverse_proxy backend-api:8000
  }
  handle /api/* {
    reverse_proxy backend-api:8000
  }
  handle /s/* {
    reverse_proxy backend-api:8000
  }
  handle {
    reverse_proxy frontend:3000
  }
}

status.{$SITE_DOMAIN} {
  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  reverse_proxy uptime-kuma:3001
}
