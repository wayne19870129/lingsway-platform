# Domains are deliberately independent.
SITE_DOMAIN=lingsway.com
API_DOMAIN=api.lingsway.com
SUBSCRIPTION_DOMAIN=lingsway.com

# Application and database
APP_ENV=development
DATABASE_URL=
TEST_DATABASE_URL=
SECRET_ENCRYPTION_KEY=
JWT_SECRET=

# Provider selection
EGRESS_PROVIDER=mock
ACCOUNTING_PROVIDER=mock
GATEWAY_PROVIDER=mock
FORWARDER_PROVIDER=mock
PAYMENT_PROVIDER=mock
NOTIFY_PROVIDER=noop
EMAIL_PROVIDER=noop
CAPTCHA_PROVIDER=noop
STORAGE_PROVIDER=mock
TRANSPORT_PROVIDER_MODE=mock
TRANSPORT_CACHE_ROOT=/app/data/transport

# Egress and accounting
WEBSHARE_API_KEY=
MARZBAN_BASE_URL=https://marzban:8000
MARZBAN_CA_CERT_PATH=/app/data/marzban/internal.crt
MARZBAN_ADMIN_USERNAME=
MARZBAN_ADMIN_PASSWORD=

# Notifications and email
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Captcha
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Blob storage and backup
STORAGE_LOCAL_PATH=data/storage
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
BACKUP_GPG_RECIPIENT=

# Runtime feature switches
ENABLE_MONITORING=false
ENABLE_PROBE=false
ENABLE_SOCKS_1080=false
RESTART_TRANSPORT=0

# Legacy migration inventory (names only; values must be supplied explicitly).
ACCOUNTING_SYNC_BATCH_SIZE=
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
CORS_ORIGINS=
CTRL_GW_PUBLIC_IP=
DOMAIN=
GRACE_PERIOD_HOURS=
LOCAL_PROXY=
LOG_LEVEL=
MARZBAN_ADMIN_CREDENTIAL=
MARZBAN_DEFAULT_INBOUNDS_JSON=
MARZBAN_DEFAULT_PROTOCOL=
MARZBAN_IMAGE=
MARZBAN_VERIFY_TLS=
XRAY_REALITY_DEST=
XRAY_REALITY_SERVER_NAME=
# Read by Settings and consumed by GATEWAY_PROVIDER=xray_file. Shown with their
# code defaults (backend/app/core/config.py) rather than blank, because these
# three are NOT safe to leave empty:
#   - XRAY_LOG_LEVEL is validated against debug|info|warning|error|none and an
#     empty value raises at startup rather than falling back to the default.
#   - the two paths are used verbatim; an empty value is not treated as "unset".
# Unset them entirely (delete the line) to accept the code default.
XRAY_CONFIG_PATH=/app/data/marzban/xray_config.json
XRAY_BACKUP_DIR=/app/data/xray-reload
XRAY_LOG_LEVEL=warning
MIHOMO_API_SECRET=
MIHOMO_EGRESS_ROUTE_MODE=
MIHOMO_IMAGE=
MIHOMO_INTERNAL_LISTEN_ADDRESS=
MYSQL_DATABASE=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
NEXT_PUBLIC_API_BASE_URL=
PLAN_100GB_PRICE=
PLAN_200GB_PRICE=
PLAN_50GB_PRICE=
PLAN_500GB_PRICE=
PLAN_CURRENCY=
PROVIDER_A_SUBSCRIPTION_URL=
PROVIDER_B_SUBSCRIPTION_URL=
RESIDENTIAL_PROXY_01_HOST=
RESIDENTIAL_PROXY_01_PASSWORD=
RESIDENTIAL_PROXY_01_PORT=
RESIDENTIAL_PROXY_01_PROTOCOL=
RESIDENTIAL_PROXY_01_USERNAME=
SUBSCRIPTION_BASE_URL=
WEBSHARE_OPS_RESERVE_GB=
WEBSHARE_TOTAL_QUOTA_GB=
